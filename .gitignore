# Uploaded user files — never commit these
static/uploads/*
!static/uploads/.gitkeep

# Backup archives — private data, never commit
backups/

# Runtime data — private data, never commit (anchored to repo root — don't match
# scripts/reload_data_seeds/data, the private submodule)
/data/

# Source reloading-data PDFs (Hodgdon/Nosler/Speer/Sierra/Barnes/etc.) — copyrighted manufacturer
# manuals, never commit
static/reloading_data/

# Hand-transcribed reload-data (manufacturer-specific numbers derived from copyrighted manuals)
# lives in a private submodule at scripts/reload_data_seeds/data — see .gitmodules. The reusable
# importer helper (_common.py) stays here, public, since it contains no manufacturer data.

# SQLite database
*.db
*.db-shm
*.db-wal

# PyInstaller build output (desktop packaging) — regenerated per build, never commit
/dist/
/build/

# WebView2 bootstrapper — fetched by the desktop-installer CI step, not committed (Microsoft
# updates it independently of our release cadence)
desktop/windows/MicrosoftEdgeWebView2Setup.exe

# macOS app icon — generated at CI build time via sips/iconutil (needs macOS itself), not
# committed since this Linux sandbox can't produce a valid .icns to check in
desktop/macos/icon.iconset/
desktop/macos/icon.icns

# Python cache
__pycache__/
*.py[cod]

# Virtual environment
venv/
.venv/

# Environment / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db
static/htmls/

# Claude Code's own local settings dir — created whenever it runs against this repo (e.g. a
# service-account HOME won't see a personal global gitignore, so this must be excluded here to
# keep `git status --porcelain` clean for the app's own upgrade/rollback dirty-check).
.claude/
